        <client_callable>false</client_callable>
        <description>On demand Script Include to validate email address syntax using regular expressions.</description>
        <mobile_callable>false</mobile_callable>
        <name>validateEmailAddress</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[function validateEmailAddress(emailString) {
    emailString = emailString + '';

    if (emailString.match(/^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/)) {
        return true;
    } else {
        return false;
    }
}]]></script>
